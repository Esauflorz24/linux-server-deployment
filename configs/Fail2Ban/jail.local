[apache-auth]
enabled = true
port = http,https
logpath = %(apache_error_log)s
maxretry = 3

[apache-badbots]
enabled = true
port = http,https
logpath = %(apache_access_log)s
bantime = 48h
maxretry = 1

[apache-noscript]
enabled = true
port = http,https
logpath = %(apache_error_log)s
maxretry = 3

[apache-overflows]
enabled = true
port = http,https
logpath = %(apache_error_log)s
maxretry = 2

[apache-nohome]
enabled = true
port = http,https
logpath = %(apache_error_log)s
maxretry = 2
